<?xml version="1.0" encoding="UTF-8"?>
<!-- DRAFT privacy manifest for P'Joe's native iOS build (not used by the web app).
     Assumes: no tracking, no data collected off-device, local notifications only,
     persistence via UserDefaults (or WKWebView localStorage) in the app's own container.
     Re-check against Apple's current "Describing use of required reason API" list before submitting,
     and add entries for any SDK you embed. See HANDOFF.md §8. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: read/write info only accessible to the app itself -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
